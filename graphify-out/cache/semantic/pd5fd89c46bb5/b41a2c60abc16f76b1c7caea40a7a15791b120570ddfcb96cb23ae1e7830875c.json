{"nodes": [{"id": "supabase_readme_sql_first_schema", "label": "SQL-First Schema (no vendored Supabase CLI stack)", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "lines 1-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repo does not vendor the Supabase CLI local dev stack because `supabase start` needs Docker, which was unavailable in the authoring environment; migrations were smoke-tested against a plain local Postgres 16 instead."}, {"id": "supabase_readme_migrations", "label": "Numbered Migrations (applied in order)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "lines 46-59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict numeric ordering encodes hard dependencies: enums before tables, tables before the state engine, state engine before RLS and projections."}, {"id": "supabase_readme_0001_extensions_enums", "label": "0001_extensions_enums.sql", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0002_core", "label": "0002_core.sql", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds workspace, people, RBAC, clients, notifications and audit log \u2014 the shared core every space depends on."}, {"id": "supabase_readme_0003_delivery", "label": "0003_delivery.sql", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0004_product", "label": "0004_product.sql", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0005_hypercare", "label": "0005_hypercare.sql", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0006_state_engine", "label": "0006_state_engine.sql \u2014 the authoritative state engine", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One authoritative state/calculation engine (gate status, project health, progress, service health) plus triggers keeping cached columns in sync, so no screen recomputes its own numbers."}, {"id": "supabase_readme_0007_rls", "label": "0007_rls.sql \u2014 Row Level Security", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three enforcement tiers \u2014 internal workspace members, client-portal users, and the public boundary \u2014 so the client/public surface is constrained in the database, not just in the UI."}, {"id": "supabase_readme_0008_projections", "label": "0008_projections.sql \u2014 client/public projections", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fn_publish_client_view, fn_public_share_view and fn_client_portal_project are the ONLY paths through which client/public code ever reads delivery data \u2014 a deliberate single choke point for the external boundary."}, {"id": "supabase_readme_fn_publish_client_view", "label": "fn_publish_client_view", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_fn_public_share_view", "label": "fn_public_share_view", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_fn_client_portal_project", "label": "fn_client_portal_project", "file_type": "code", "source_file": "supabase/README.md", "source_location": "line 59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_seed_sql", "label": "seed.sql \u2014 demo portfolio", "file_type": "code", "source_file": "supabase/README.md", "source_location": "lines 17-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds the same Nutrition Kitchen / Halcyon Freight / Beacon Dental / Ridgeline Outdoor data used by the design mockups, so every screen has something to show on first run."}, {"id": "supabase_readme_seed_nk_live", "label": "seed_nk_live.sql \u2014 idempotent live client seed", "file_type": "code", "source_file": "supabase/README.md", "source_location": "lines 23-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe to run on production and safe to re-run: every insert uses a real unique constraint (on conflict do update) or an explicit find-or-create check, so re-running updates rows instead of duplicating them. Loads the aironauts flight plan as master template plus the Nutrition Kitchen 'Order to procurement' engagement from the Phase 1 kickoff deck."}, {"id": "supabase_readme_database_types", "label": "src/lib/supabase/database.types.ts", "file_type": "code", "source_file": "supabase/README.md", "source_location": "lines 35-40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Currently hand-written to match the migrations exactly; regenerating with `npm run supabase:gen-types` against a real project replaces it with the authoritative version."}, {"id": "supabase_readme_dev_stubs", "label": "dev/ local stub auth and grants", "file_type": "code", "source_file": "supabase/README.md", "source_location": "lines 61-67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "local_stub_auth.sql and local_stub_grants.sql exist only to smoke-test migrations on bare Postgres that lacks Supabase's auth schema and anon/authenticated roles; they must NEVER be run against a real Supabase project, which already provides all of this."}, {"id": "supabase_readme_test_migrations_script", "label": "scripts/test-migrations.sh", "file_type": "code", "source_file": "supabase/README.md", "source_location": "lines 66-67", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_first_workspace_admin_invite", "label": "Invite the First workspace_admin", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "lines 41-44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No onboarding trigger is shipped because auto-creating the `people` row depends on each deployment's own invite flow."}], "edges": [{"source": "readme_claude_design_source", "target": "supabase_readme_seed_sql", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "supabase/README.md", "source_location": "lines 17-19", "weight": 1.0}, {"source": "supabase_readme_0006_state_engine", "target": "docs_guide_en_database_computed_state", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "supabase/README.md", "source_location": "line 57", "weight": 1.0}, {"source": "supabase_readme_migrations", "target": "supabase_readme_0001_extensions_enums", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/README.md", "source_location": "line 52", "weight": 1.0}, {"source": "supabase_readme_migra
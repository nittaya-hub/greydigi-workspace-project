{"nodes": [{"id": "docs_guide_en_setup_and_user_guide", "label": "greydigi workspace Setup and User Guide (EN)", "file_type": "document", "source_file": "docs/GUIDE.en.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guide_en_delivery", "label": "Delivery Space", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 8-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client engagements: projects, flight plans, gates, tasks, baselines, change requests, client updates, and the client-facing layer."}, {"id": "docs_guide_en_product", "label": "Product Space", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 11-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal accelerators: products, roadmap, features, releases, engineering workload."}, {"id": "docs_guide_en_hypercare", "label": "Hypercare Space", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 13-14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live client systems after go-live: services, incidents, requests, SLA, health, escalations."}, {"id": "docs_guide_en_workspace_core", "label": "Workspace Core", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 15-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients, people and roles, templates, notifications, settings, audit log and search are shared by all three spaces rather than duplicated per space."}, {"id": "docs_guide_en_public_share_page", "label": "Public Share Page /s/[token]", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 18-20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A no-login, read-only project page lets clients and outside stakeholders see progress without provisioning accounts; it sits outside the internal app entirely."}, {"id": "docs_guide_en_client_portal", "label": "Client Portal /portal/[project-ref]", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 21-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authenticated client view for people with kind='client' and a client_roles grant, where clients review progress and complete requested actions."}, {"id": "docs_guide_en_database_computed_state", "label": "Database-Computed State (single source of truth)", "file_type": "rationale", "source_file": "docs/GUIDE.en.md", "source_location": "lines 24-26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every number on screen (gate status, project health, service health, release readiness) is computed by the database rather than typed on a page, so the same figure always agrees across every screen that shows it."}, {"id": "docs_guide_en_environment_variables", "label": "Environment Variables (.env.local)", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 52-75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NEXT_PUBLIC_SITE_URL must match the app's real URL and be registered in Supabase Redirect URLs, otherwise email sign-in links break; the service_role key must stay private."}, {"id": "docs_guide_en_google_sign_in", "label": "Google Sign-in (Supabase OAuth Provider)", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 77-102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already wired in the app but off by default; a Google sign-in only creates a Supabase Auth account, so a matching `people` row is still required before workspace access."}, {"id": "docs_guide_en_magic_link_sign_in", "label": "Magic Link Sign-in", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 186-188", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guide_en_email_password_sign_in", "label": "Email & Password Sign-in", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 184-185", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guide_en_people_table", "label": "people Table (auth_user_id bridge)", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 133-146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Supabase Auth user alone grants nothing; workspace identity, kind (internal/client) and workspace_role live in `people`, joined to auth via auth_user_id."}, {"id": "docs_guide_en_first_workspace_admin", "label": "First Workspace Admin Bootstrap", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 122-151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual SQL insert is a deliberate one-time bootstrap step because the app has no self-serve sign-up; everyone after the first admin is added from inside the app."}, {"id": "docs_guide_en_no_self_serve_signup", "label": "No Self-Serve Sign-up (provisioned access)", "file_type": "rationale", "source_file": "docs/GUIDE.en.md", "source_location": "line 124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access is provisioned deliberately rather than opened to sign-up, so no one can create their own way into a client workspace."}, {"id": "docs_guide_en_invite_flow", "label": "Invite Flow (/people/invite)", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 153-172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates the Supabase Auth account and the `people` row in one step and shows a one-time temporary password; only a workspace admin may invite, checked both on the page and in the underlying action (defence in depth)."}, {"id": "docs_guide_en_set_password", "label": "Change Password (/auth/set-password)", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 167-169", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guide_en_client_view_config_publish", "label": "Client View Config \u2192 Publish", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 202-205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing reaches the client portal or a public share link until an explicit Publish, so internal work-in-progress is never accidentally exposed; the 'last published' date is the confirmation signal."}, {"id": "docs_guide_en_share_links", "label": "Public Share Links (with Preview)", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 206-208", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preview shows exactly what an outside viewer sees, so the internal user can verify the public boundary before sending the link."}, {"id": "docs_guide_en_app_navigation", "label": "App Navigation (sidebar, header, project tabs)", "file_type": "concept", "source_file": "docs/GUIDE.en.md", "source_location": "lines 191-201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guide_en_deploying_vercel", "label": "Deploying to Vercel", "file_type": "document", "source_file": "docs/GUIDE.en.md", "source_location": "lines 214-223", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guide_en_troubleshooting", "label": "Troubleshooting", "file_type": "document", "source_file": "docs/GUIDE.en.md", "source_location": "lines 225-249", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most reported failures trace back to three causes: wrong env vars, migrations not run, or an auth user with no matching `people` row."}], "edges": [{"source": "docs_guide_en_setup_and_user_guide", "target": "supabase_readme_sql_first_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUIDE.en.md", "source_location": "lines 119-120", "weight": 1.0}, {"source": "docs_guide_en_delivery", "target": "docs_guide_en_public_share_page", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUIDE.en.md", "source_location": "lines 8-20", "weight": 1.0}, {"source": "docs_guide_en_delivery", "target": "docs_guide_en_client_portal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUIDE.en.md", "source_location": "lines 8-22", "weight": 1.0}, {"source": "docs_guide_en_delivery", "target": "docs_guide_en_workspace_core", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUIDE.en.md", "source_location": "lines 15-16", "weight": 1.0}, {"source": "docs_guide_en_product", "target": "docs_guide_en_workspace_core", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUIDE.en.md", "source_location": "lines 15-16", "weight": 1.0}, {"source": "docs_guide_en_hypercare", "target": "docs_guide_en_workspace_core", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUIDE.en.md", "source_location": "lines 15-16", "weight": 1.0}, {"source": "docs_guide_en_hypercare", "target": "docs_guide_en_delivery", "relation": "conceptually_related_to", "confidence": "INFERRED", "co